{
  "name": "property-growth-estimator-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "node --loader ts-node/esm src/server.ts",
    "cli": "node --loader ts-node/esm src/cli.ts",
    "fixture": "node --loader ts-node/esm src/fixture-runner.ts",
    "test": "node --loader ts-node/esm test/run-tests.ts",
    "test:unit": "node --loader ts-node/esm test/unit-tests.ts",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axios": "^1.8.4",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "https-proxy-agent": "^7.0.6",
    "playwright": "^1.52.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  }
}
